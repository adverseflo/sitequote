# Copy this file to .env and fill in your keys. Never commit .env.

# Nebius Token Factory (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Run `npm run models` to see the exact Nemotron model IDs your key can use
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Tavily search (https://tavily.com)
TAVILY_API_KEY=

# Default labour rate in GBP per hour (the builder can change it in the UI)
LABOUR_RATE=35
VAT_RATE=0.20

PORT=3000

# Set to 1 to return sample data without calling any APIs (handy for frontend work)
MOCK=0
